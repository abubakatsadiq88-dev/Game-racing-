def draw_track(surface):
    surface.fill(GRASS_COLOR)
    # Main track
    pygame.draw.circle(surface, TRACK_COLOR, (WIDTH//2, HEIGHT//2), 280, 125)
    # Inner lines
    for i in range(0, 360, 18):
        angle = math.radians(i)
        x1 = WIDTH//2 + 185 * math.cos(angle)
        y1 = HEIGHT//2 + 95 * math.sin(angle)
        x2 = WIDTH//2 + 315 * math.cos(angle)
        y2 = HEIGHT//2 + 205 * math.sin(angle)
        pygame.draw.line(surface, LINE_COLOR, (x1, y1), (x2, y2), 5)

